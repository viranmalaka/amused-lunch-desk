// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum MealType {
  BREAKFAST
  LUNCH
}

// A category like "Chicken", "Veg", "Salad"
model Preference {
  id   String @id @default(cuid())
  name String @unique

  // A menu item can be linked to a preference
  menuItems MenuItem[]

  // Users can have a default preference
  defaultForUsers User[]

  // Orders can be placed with a preference before the menu is known
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Represents the menu for a specific day and meal type
model Menu {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  mealType  MealType
  published Boolean  @default(false)

  // The items available in this menu
  items MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, mealType])
}

// A specific item on a menu, e.g., "Chicken Biriyani"
model MenuItem {
  id   String @id @default(cuid())
  name String

  // The menu this item belongs to
  menu   Menu   @relation(fields: [menuId], references: [id])
  menuId String

  // The preference category this item falls under
  preference   Preference? @relation(fields: [preferenceId], references: [id])
  preferenceId String?

  // The orders placed for this item
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An order placed by a user for a specific day/meal
model Order {
  id String @id @default(cuid())

  // The user who placed the order
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  date     DateTime @db.Date
  mealType MealType

  // If the final menu item is selected
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  menuItemId String?

  // If a preference is selected before the menu is available
  preference   Preference? @relation(fields: [preferenceId], references: [id])
  preferenceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, mealType])
}

// Necessary for Next-auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EMPLOYEE)

  // Password auth fields (for users who can't use AD)
  password          String? // Hashed password
  tempPassword      Boolean   @default(false) // If true, user must change password on login
  passwordUpdatedAt DateTime?

  // A user can set a default preference for quick selection
  defaultPreference   Preference? @relation(fields: [defaultPreferenceId], references: [id])
  defaultPreferenceId String?

  accounts Account[]
  sessions Session[]
  orders   Order[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
